# ============================================================================
# Production multi-stage build для repa (используется только CI, GitHub Actions).
# Таргеты:
#   app   — php-fpm образ с кодом, vendor (--no-dev) и собранным фронтендом
#   nginx — nginx + public/ из образа app
# Оба публикуются в GHCR; на сервере ничего не собирается.
# ============================================================================

# --- Стадия 1: PHP-зависимости (vendor, без dev, без скриптов) ---------------
# composer:2 — alpine-база, пакеты ставим через apk. Расширения нужны для
# platform-проверки composer (Filament требует ext-intl и др.).
FROM composer:2 AS vendor
WORKDIR /app
RUN apk add --no-cache \
        icu-dev \
        postgresql-dev \
        zlib-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libzip-dev \
        oniguruma-dev \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install intl zip gd bcmath mbstring exif pcntl pdo_pgsql pgsql
COPY composer.json composer.lock ./
RUN composer install \
      --no-dev \
      --no-scripts \
      --no-interaction \
      --prefer-dist \
      --optimize-autoloader

# --- Стадия 2: фронтенд (vite build) ------------------------------------------
FROM node:20-alpine AS frontend
WORKDIR /app
# vendor нужен на этой стадии: vite-сборка импортирует CSS Filament из vendor.
COPY --from=vendor /app/vendor /app/vendor
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# --- Стадия 3: база приложения -------------------------------------------------
FROM php:8.3-fpm AS base

RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    zip \
    libpq-dev \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-jpeg --with-freetype
RUN docker-php-ext-install \
    pdo_pgsql \
    pgsql \
    gd \
    zip \
    bcmath \
    mbstring \
    exif \
    pcntl \
    opcache \
    intl

RUN pecl install redis && docker-php-ext-enable redis

WORKDIR /var/www/html

COPY --from=vendor /app/vendor /var/www/html/vendor
COPY --from=frontend /app/public/build /var/www/html/public/build
COPY . /var/www/html

# storage/ и bootstrap/cache должны быть доступны на запись www-data.
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/framework/testing \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Служебные шаги Laravel/Filament без обращения к БД.
# APP_KEY — заглушка только для boot'а artisan на этапе сборки (ARG не попадает
# в образ); в рантайме значение приходит из env_file (/srv/repa/.env на сервере).
ARG APP_KEY=base64:QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
RUN php artisan package:discover --ansi \
    && php artisan filament:upgrade --no-interaction \
    && php artisan storage:link \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/app/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]

# --- Стадия 4: nginx ------------------------------------------------------------
FROM nginx:1.27-alpine AS nginx
COPY --from=base /var/www/html/public /var/www/html/public
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

# Локально сгенерированные кэши (Laravel/Filament) не должны попадать в образ:
# они запекают локальные настройки и dev-провайдеры (например, laravel/pail).
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/framework/*
!storage/framework/.gitignore
storage/logs/*
!storage/logs/.gitignore

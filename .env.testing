# Тесты используют изолированную SQLite-базу в памяти, а не реальный Postgres
# из docker-compose — иначе RefreshDatabase в Feature-тестах стирает dev-данные.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

MAIL_MAILER=array
